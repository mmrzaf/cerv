# Example: build a Vite/React/Vue-style SPA and serve the final dist/ with Cerv.
# First build/tag Cerv itself, for example: docker build -t cerv:1.0.0 .

FROM node:24-bookworm-slim AS app-build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM cerv:1.0.0
COPY --from=app-build /app/dist/ /srv/cerv/
ENV CERV_SPA_FALLBACK=/index.html
